{
    "$schema": "https://opencode.ai/config.json",
    "experimental": {
        "mcp_timeout": 3600000
    },
    "plugin": [
        "opencode-gemini-auth@latest",
        "opencode-claude-auth@latest",
        "opencode-snippets@latest",
        "opencode-notify@latest",
        "envsitter-guard@latest",
        "@ykaratkou/opencode-worktree@0.1.0",
        "@tarquinen/opencode-dcp@latest",
        "opencode-autotitle@latest",
        "./plugins/graphify.js",
        "./plugins/engram.ts",
        "./plugins/squeez.js",
        "opencode-vibeguard@latest",
        ["@plannotator/opencode@latest", { "workflow": "all-agents" }],
        "@nick-vi/opencode-type-inject@latest"
    ],
    "theme": "catppuccin",
    "autoupdate": true,
    "mcp": {
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "enabled": true
        },
        "engram": {
            "type": "local",
            "command": [
                "/home/andres/.local/bin/engram",
                "mcp",
                "--tools=agent"
            ],
            "enabled": true
        },
        "gh_grep": {
            "type": "remote",
            "url": "https://mcp.grep.app",
            "enabled": true
        },
        "codebase-memory-mcp": {
            "type": "local",
            "command": [
                "/home/andres/.local/bin/codebase-memory-mcp"
            ],
            "enabled": true
        },
        "gcp": {
            "type": "remote",
            "url": "https://run.googleapis.com/mcp",
            "enabled": true
        }
    },
    "agent": {
        "build": {
            "disable": true
        },
        "plan": {
            "disable": true
        },
        "PE_build": {
            "disable": true
        },
        "PE_plan": {
            "disable": true
        }
    },
    "default_agent": "commander",
    "model": "{{MODEL:model}}",
    "small_model": "{{MODEL:small_model}}"
}
