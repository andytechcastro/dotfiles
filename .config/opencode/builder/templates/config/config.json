{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "commander",
    "model": "{{MODEL:model}}",
    "update": "notify",
    "share": "disabled",
    "permissions": [
        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": "*.env.*", "effect": "deny" },
        { "action": "edit", "resource": "*.env", "effect": "deny" },
        { "action": "edit", "resource": "*.env.*", "effect": "deny" },
        { "action": "read", "resource": "*.env.example", "effect": "allow" },
        { "action": "edit", "resource": "*.env.example", "effect": "allow" },
        { "action": "read", "resource": "*.ssh/*", "effect": "deny" },
        { "action": "edit", "resource": "*.ssh/*", "effect": "deny" },
        { "action": "read", "resource": "*.secret_envs*", "effect": "deny" },
        { "action": "edit", "resource": "*.secret_envs*", "effect": "deny" },
        { "action": "read", "resource": "*cli-proxy-api*", "effect": "deny" },
        { "action": "read", "resource": "*.config/gh/hosts.yml", "effect": "deny" },
        { "action": "read", "resource": "*.netrc", "effect": "deny" },
        { "action": "read", "resource": "*.local/share/opencode/auth.json", "effect": "deny" },
        { "action": "edit", "resource": "*.local/share/opencode/auth.json", "effect": "deny" },
        { "action": "read", "resource": "*.local/share/opencode/opencode.db*", "effect": "deny" },
        { "action": "edit", "resource": "*.local/share/opencode/opencode.db*", "effect": "deny" }
    ],
    "experimental": {
        "policies": [
            { "action": "provider.use", "resource": "*", "effect": "deny" },
            { "action": "provider.use", "resource": "opencode-go", "effect": "allow" },
            { "action": "provider.use", "resource": "google", "effect": "allow" }
        ]
    },
    "plugins": [
        "opencode-snippets@3.2.0",
        "@tarquinen/opencode-dcp@3.2.0",
        "opencode-antigravity-auth@2.1.2",
        {
            "package": "@plannotator/opencode@0.27.20",
            "options": {
                "workflow": "plan-agent",
                "planningAgents": ["commander"]
            }
        }
    ],
    "providers": {},
    "mcp": {
        "servers": {
            "context7": {
                "type": "remote",
                "url": "https://mcp.context7.com/mcp",
                "disabled": false,
                "timeout": {
                    "catalog": 10000,
                    "execution": 60000
                }
            },
            "engram": {
                "type": "local",
                "command": [
                    "/home/andres/.local/bin/engram",
                    "mcp",
                    "--tools=agent"
                ],
                "disabled": false,
                "timeout": {
                    "catalog": 10000,
                    "execution": 60000
                }
            },
            "gh_grep": {
                "type": "remote",
                "url": "https://mcp.grep.app",
                "disabled": false,
                "timeout": {
                    "catalog": 10000,
                    "execution": 60000
                }
            },
            "codebase-memory-mcp": {
                "type": "local",
                "command": [
                    "/home/andres/.local/bin/codebase-memory-mcp"
                ],
                "disabled": false,
                "timeout": {
                    "catalog": 10000,
                    "execution": 600000
                }
            },
            "gcp": {
                "type": "remote",
                "url": "https://run.googleapis.com/mcp",
                "disabled": false,
                "timeout": {
                    "catalog": 10000,
                    "execution": 60000
                }
            },
            "google_drive": {
                "type": "remote",
                "url": "https://drivemcp.googleapis.com/mcp/v1",
                "disabled": false,
                "timeout": {
                    "catalog": 10000,
                    "execution": 300000
                },
                "oauth": {
                    "client_id": "${GOOGLE_CLIENT_ID}",
                    "client_secret": "${GOOGLE_CLIENT_SECRET}",
                    "scope": "https://www.googleapis.com/auth/drive https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/documents https://www.googleapis.com/auth/documents.readonly"
                },
                "_requires_env": ["GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"]
            },
            "playwright": {
                "type": "local",
                "command": [
                    "npx",
                    "-y",
                    "@playwright/mcp@0.0.83"
                ],
                "disabled": false,
                "timeout": {
                    "catalog": 10000,
                    "execution": 600000
                }
            }
        }
    },
    "agents": {
        "title": {
            "model": "{{MODEL:small_model}}"
        },
        "build": {
            "disabled": true
        },
        "plan": {
            "disabled": true
        }
    }
}
