{
    "$schema": "https://opencode.ai/config.json",
    "experimental": {
        "mcp_timeout": 3600000
    },
    "permissions": [
        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": "*.env.*", "effect": "deny" },
        { "action": "edit", "resource": "*.env", "effect": "deny" },
        { "action": "edit", "resource": "*.env.*", "effect": "deny" }
    ],
    "plugins": [
        "opencode-snippets@latest",
        "@tarquinen/opencode-dcp@latest",
        {
            "package": "@plannotator/opencode@latest",
            "options": {
                "workflow": "plan-agent",
                "planningAgents": ["commander"]
            }
        }
    ],
    "providers": {
        "antigravity": {
            "name": "Antigravity (Google AI Pro via CLIProxyAPI)",
            "env": ["CLIPROXY_API_KEY"],
            "package": "@opencode/ai/providers/openai-compatible",
            "settings": { "baseURL": "http://127.0.0.1:8317/v1" },
            "models": {
                "claude-opus-4-6-thinking": {},
                "claude-opus-5-5-high": {},
                "claude-sonnet-4-6": {},
                "claude-sonnet-5-5-high": {},
                "gemini-3-flash": {},
                "gemini-3.1-flash-image": {},
                "gemini-3.1-flash-lite": {},
                "gemini-3.1-pro-low": {},
                "gemini-3.5-flash-lite": {},
                "gemini-3.6-flash-high": {},
                "gemini-3.7-flash-high": {},
                "gemini-3.8-flash-high": { "name": "Gemini 3.8 Flash (high, AI Pro quota)" },
                "gemini-pro-agent": {},
                "gpt-oss-120b-medium": {}
            }
        }
    },
    "theme": "catppuccin",
    "autoupdate": true,
    "mcp": {
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "enabled": true
        },
        "engram": {
            "type": "local",
            "command": [
                "/home/andres/.local/bin/engram",
                "mcp",
                "--tools=agent"
            ],
            "enabled": true
        },
        "gh_grep": {
            "type": "remote",
            "url": "https://mcp.grep.app",
            "enabled": true
        },
        "codebase-memory-mcp": {
            "type": "local",
            "command": [
                "/home/andres/.local/bin/codebase-memory-mcp"
            ],
            "enabled": true
        },
        "gcp": {
            "type": "remote",
            "url": "https://run.googleapis.com/mcp",
            "enabled": true
        },
        "google_drive": {
            "type": "remote",
            "url": "https://drivemcp.googleapis.com/mcp/v1",
            "enabled": true,
            "oauth": {
                "clientId": "${GOOGLE_CLIENT_ID}",
                "clientSecret": "${GOOGLE_CLIENT_SECRET}",
                "scopes": [
                    "https://www.googleapis.com/auth/drive",
                    "https://www.googleapis.com/auth/drive.readonly",
                    "https://www.googleapis.com/auth/documents",
                    "https://www.googleapis.com/auth/documents.readonly"
                ]
            },
            "_requires_env": ["GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"]
        },
        "playwright": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@playwright/mcp@latest"
            ],
            "enabled": true
        }
    },
    "agent": {
        "title": {
            "model": "{{MODEL:small_model}}"
        },
        "build": {
            "disable": true
        },
        "plan": {
            "disable": true
        },
        "PE_build": {
            "disable": true
        },
        "PE_plan": {
            "disable": true
        }
    },
    "default_agent": "commander",
    "model": "{{MODEL:model}}",
    "small_model": "{{MODEL:small_model}}"
}
