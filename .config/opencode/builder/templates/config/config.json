{
    "$schema": "https://opencode.ai/config.json",
    "experimental": {
        "mcp_timeout": 3600000
    },
    "permissions": [
        { "action": "read", "resource": "*.env", "effect": "deny" },
        { "action": "read", "resource": "*.env.*", "effect": "deny" },
        { "action": "edit", "resource": "*.env", "effect": "deny" },
        { "action": "edit", "resource": "*.env.*", "effect": "deny" }
    ],
    "plugins": [
        "opencode-snippets@latest",
        "@tarquinen/opencode-dcp@latest",
        {
            "package": "@plannotator/opencode@latest",
            "options": {
                "workflow": "plan-agent",
                "planningAgents": ["commander"]
            }
        }
    ],
    "theme": "catppuccin",
    "autoupdate": true,
    "mcp": {
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "enabled": true
        },
        "engram": {
            "type": "local",
            "command": [
                "/home/andres/.local/bin/engram",
                "mcp",
                "--tools=agent"
            ],
            "enabled": true
        },
        "gh_grep": {
            "type": "remote",
            "url": "https://mcp.grep.app",
            "enabled": true
        },
        "codebase-memory-mcp": {
            "type": "local",
            "command": [
                "/home/andres/.local/bin/codebase-memory-mcp"
            ],
            "enabled": true
        },
        "gcp": {
            "type": "remote",
            "url": "https://run.googleapis.com/mcp",
            "enabled": true
        },
        "google_drive": {
            "type": "remote",
            "url": "https://drivemcp.googleapis.com/mcp/v1",
            "enabled": true,
            "oauth": {
                "clientId": "${GOOGLE_CLIENT_ID}",
                "clientSecret": "${GOOGLE_CLIENT_SECRET}",
                "scopes": [
                    "https://www.googleapis.com/auth/drive",
                    "https://www.googleapis.com/auth/drive.readonly",
                    "https://www.googleapis.com/auth/documents",
                    "https://www.googleapis.com/auth/documents.readonly"
                ]
            },
            "_requires_env": ["GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"]
        },
        "playwright": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@playwright/mcp@latest"
            ],
            "enabled": true
        }
    },
    "agent": {
        "title": {
            "model": "{{MODEL:small_model}}"
        },
        "build": {
            "disable": true
        },
        "plan": {
            "disable": true
        },
        "PE_build": {
            "disable": true
        },
        "PE_plan": {
            "disable": true
        }
    },
    "default_agent": "commander",
    "model": "{{MODEL:model}}",
    "small_model": "{{MODEL:small_model}}"
}
