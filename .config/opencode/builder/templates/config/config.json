{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "commander",
    "model": "{{MODEL:model}}",
    "update": "notify",
    "share": "disabled",

    "experimental": {
        "policies": [
            { "action": "tool.use", "resource": "read:*.ssh*", "effect": "deny" },
            { "action": "tool.use", "resource": "read:*.env*", "effect": "deny" },
            { "action": "tool.use", "resource": "read:*.secret_envs*", "effect": "deny" },
            { "action": "tool.use", "resource": "read:*.netrc*", "effect": "deny" },
            { "action": "tool.use", "resource": "read:*.config/gh/hosts.yml*", "effect": "deny" },
            { "action": "tool.use", "resource": "read:*auth.json*", "effect": "deny" },
            { "action": "tool.use", "resource": "read:*opencode.db*", "effect": "deny" },
            { "action": "tool.use", "resource": "read:*cli-proxy-api*", "effect": "deny" },
            { "action": "tool.use", "resource": "read:*.config/opencode/opencode.json*", "effect": "deny" },
            { "action": "tool.use", "resource": "edit:*.ssh*", "effect": "deny" },
            { "action": "tool.use", "resource": "edit:*.env*", "effect": "deny" },
            { "action": "tool.use", "resource": "edit:*.secret_envs*", "effect": "deny" },
            { "action": "tool.use", "resource": "edit:*.netrc*", "effect": "deny" },
            { "action": "tool.use", "resource": "edit:*.config/gh/hosts.yml*", "effect": "deny" },
            { "action": "tool.use", "resource": "edit:*auth.json*", "effect": "deny" },
            { "action": "tool.use", "resource": "edit:*opencode.db*", "effect": "deny" },
            { "action": "tool.use", "resource": "edit:*cli-proxy-api*", "effect": "deny" },
            { "action": "tool.use", "resource": "edit:*.config/opencode/opencode.json*", "effect": "deny" },
            { "action": "tool.use", "resource": "shell:*.ssh*", "effect": "deny" },
            { "action": "tool.use", "resource": "shell:*.env*", "effect": "deny" },
            { "action": "tool.use", "resource": "shell:*.secret_envs*", "effect": "deny" },
            { "action": "tool.use", "resource": "shell:*.netrc*", "effect": "deny" },
            { "action": "tool.use", "resource": "shell:*.config/gh/hosts.yml*", "effect": "deny" },
            { "action": "tool.use", "resource": "shell:*auth.json*", "effect": "deny" },
            { "action": "tool.use", "resource": "shell:*opencode.db*", "effect": "deny" },
            { "action": "tool.use", "resource": "shell:*cli-proxy-api*", "effect": "deny" },
            { "action": "tool.use", "resource": "shell:*.config/opencode/opencode.json*", "effect": "deny" },
            { "action": "provider.use", "resource": "*", "effect": "deny" },
            { "action": "provider.use", "resource": "opencode-go", "effect": "allow" },
            { "action": "provider.use", "resource": "google", "effect": "allow" },
            { "action": "provider.use", "resource": "antigravity-acp", "effect": "allow" },
            { "action": "tool.use", "resource": "read:*antigravity-oauth-token*", "effect": "deny" },
            { "action": "tool.use", "resource": "edit:*antigravity-oauth-token*", "effect": "deny" },
            { "action": "tool.use", "resource": "shell:*antigravity-oauth-token*", "effect": "deny" },
            {"action": "tool.use", "resource": "shell:*squeez wrap*git add*", "effect": "deny"},
            {"action": "tool.use", "resource": "shell:*squeez wrap*git commit*", "effect": "deny"},
            {"action": "tool.use", "resource": "shell:*squeez wrap*git push*", "effect": "deny"},
            {"action": "tool.use", "resource": "shell:*squeez wrap*git pull*", "effect": "deny"},
            {"action": "tool.use", "resource": "shell:*squeez wrap*git merge*", "effect": "deny"},
            {"action": "tool.use", "resource": "shell:*squeez wrap*git rebase*", "effect": "deny"},
            {"action": "tool.use", "resource": "shell:*squeez wrap*git reset*", "effect": "deny"},
            {"action": "tool.use", "resource": "shell:*squeez wrap*git checkout*", "effect": "deny"},
            {"action": "tool.use", "resource": "shell:*squeez wrap*git stash*", "effect": "deny"},
            {"action": "tool.use", "resource": "shell:*squeez wrap*git cherry-pick*", "effect": "deny"},
            {"action": "tool.use", "resource": "shell:*squeez wrap*rm -rf /*", "effect": "deny"},
            {"action": "tool.use", "resource": "shell:*squeez wrap*sudo *", "effect": "deny"},
            {"action": "tool.use", "resource": "shell:*squeez wrap*mkfs*", "effect": "deny"},
            {"action": "tool.use", "resource": "shell:*squeez wrap*dd *", "effect": "deny"}
        ]
    },
    "plugins": [
        "opencode-snippets@3.4.0",
        "opencode-antigravity-acp@0.1.0",
        "@tarquinen/opencode-dcp@3.2.0",
        {
            "package": "@plannotator/opencode@latest",
            "options": {
                "workflow": "plan-agent",
                "planningAgents": ["commander"]
            }
        }
    ],
    "providers": {},
    "mcp": {
        "servers": {
            "context7": {
                "type": "remote",
                "url": "https://mcp.context7.com/mcp",
                "disabled": false,
                "timeout": {
                    "catalog": 10000,
                    "execution": 60000
                }
            },
            "engram": {
                "type": "local",
                "command": [
                    "/home/andres/.local/bin/engram",
                    "mcp",
                    "--tools=agent"
                ],
                "disabled": false,
                "timeout": {
                    "catalog": 10000,
                    "execution": 60000
                }
            },
            "gh_grep": {
                "type": "remote",
                "url": "https://mcp.grep.app",
                "disabled": false,
                "timeout": {
                    "catalog": 10000,
                    "execution": 60000
                }
            },
            "codebase-memory-mcp": {
                "type": "local",
                "command": [
                    "/home/andres/.local/bin/codebase-memory-mcp"
                ],
                "disabled": false,
                "timeout": {
                    "catalog": 10000,
                    "execution": 600000
                }
            },
            "gcp": {
                "type": "remote",
                "url": "https://run.googleapis.com/mcp",
                "disabled": false,
                "timeout": {
                    "catalog": 10000,
                    "execution": 60000
                }
            },
            "google_drive": {
                "type": "remote",
                "url": "https://drivemcp.googleapis.com/mcp/v1",
                "disabled": false,
                "timeout": {
                    "catalog": 10000,
                    "execution": 300000
                },
                "oauth": {
                    "client_id": "${GOOGLE_CLIENT_ID}",
                    "client_secret": "${GOOGLE_CLIENT_SECRET}",
                    "scope": "https://www.googleapis.com/auth/drive https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/documents https://www.googleapis.com/auth/documents.readonly"
                },
                "_requires_env": ["GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"]
            },
            "playwright": {
                "type": "local",
                "command": [
                    "npx",
                    "-y",
                    "@playwright/mcp@0.0.83"
                ],
                "disabled": false,
                "timeout": {
                    "catalog": 10000,
                    "execution": 600000
                }
            }
        }
    },
    "agents": {
        "title": {
            "model": "{{MODEL:small_model}}"
        },
        "general": {
            "disabled": true
        },
        "build": {
            "disabled": true
        },
        "plan": {
            "disabled": true
        },
        "explore": {
            "model": "{{MODEL:small_model}}"
        }
    }
}
