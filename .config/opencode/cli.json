{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin"
  },
  "plugins": [],
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.4
  },
  "tabs": {
    "mode": "auto",
    "scope": "cwd",
    "indicators": "status"
  },
  "diffs": {
    "source": "turn",
    "wrap": "word",
    "tree": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show",
    "tps": true
  },
  "prompt": {
    "paste": "compact"
  },
  "keybinds": {
    "leader": "ctrl+x"
  },
  "leader": {
    "timeout": 2000
  },
  "animations": true
}
